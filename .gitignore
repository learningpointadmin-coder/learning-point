# ============================================================================
# LEARNING POINT — .gitignore (Merged: Node.js template + LP security)
# ============================================================================
# Yeh file ensure karti hai ki SECRETS kabhi GitHub par na jaayein.
# Code/migrations jaayenge, secrets nahi.
# ============================================================================

# ============================================================================
# 🔒 LEARNING POINT SECURITY (sabse zaroori)
# ============================================================================

# ---- 🔒 Environment Secrets — KABHI COMMIT NAHI ----
# NOTE: hum .env.* pattern use NAHI kar rahe kyunki usse .env.example
# bhi ignore ho jata tha. Explicit names = .env.example safe rehti hai.
.env
.env.local
.env.production
.env.staging
.env.development
.env.test
.env.*.local
*.local
# .env.example is intentionally NOT ignored (placeholders only, safe to commit)

# ---- 🔒 Google Service Account Keys ----
service-account.json
*-service-account*.json
credentials*.json
*.p12
*.pem

# ---- 🔒 Razorpay / Payment keys ----
razorpay-keys.json

# ---- 🔒 Supabase local ----
supabase/.branches
supabase/.temp

# ---- 🔒 Turso local ----
*.db
*.db-journal
*.db-wal
*.db-shm

# ============================================================================
# 📦 GENERAL NODE.JS / JAVASCRIPT (old template — kept)
# ============================================================================

# ---- Logs ----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Diagnostic reports ----
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---- Runtime data ----
pids
*.pid
*.seed
*.pid.lock

# ---- Coverage ----
lib-cov
coverage
*.lcov
.nyc_output

# ---- Dependency directories ----
node_modules/
jspm_packages/
.pnp
.pnp.*
.pnp.js
.pnpm-store

# ---- Yarn v3 ----
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn-integrity

# ---- TypeScript / lint caches ----
*.tsbuildinfo
.eslintcache
.stylelintcache
.node_repl_history

# ---- npm cache ----
.npm

# ---- npm pack output ----
*.tgz

# ============================================================================
# 🏗️ BUILD OUTPUTS & FRAMEWORK CACHES
# ============================================================================

# ---- Next.js ----
.next/
out/

# ---- Nuxt.js ----
.nuxt
dist
.output

# ---- Vite ----
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# ---- SvelteKit ----
.svelte-kit/

# ---- Cloudflare / Wrangler ----
.wrangler/

# ---- Turborepo ----
.turbo/

# ---- Parcel ----
.cache
.parcel-cache

# ---- Gatsby / VuePress / Docusaurus ----
.cache/
.vuepress/dist
.docusaurus

# ---- Serverless / FuseBox / DynamoDB local ----
.serverless/
.fusebox/
.dynamodb/

# ---- Firebase cache ----
.firebase/

# ---- Build release ----
build/Release

# ---- Other framework dirs ----
web_modules/
bower_components/
.lock-wscript
.tern-port

# ============================================================================
# 💻 EDITORS & OS
# ============================================================================

# ---- VSCode ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.vscode-test

# ---- JetBrains ----
.idea/
*.swp
*.swo

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini
