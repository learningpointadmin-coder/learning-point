# ============================================================
# Learning Point — Environment Variables Template
# ============================================================
# IS FILE ME SIRF PLACEHOLDERS HAIN — koi real value nahi.
# Local dev ke liye: isko copy karke `.env.local` banao aur
# real values daalo. `.env.local` KABHI commit mat karna.
# Production: Cloudflare/Supabase secrets dashboard se.
# ============================================================

# ---- Google Cloud ----
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-secret
# Sheets service account JSON (entire file content as string)
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ---- Google Gemini (AI Studio) ----
GEMINI_API_KEY=AIzaSy-your-key

# ---- Groq (Qwen / GPT-OSS / Whisper) ----
GROQ_API_KEY=gsk_your-key

# ---- SambaNova (DeepSeek / GPT-OSS) ----
SAMBANOVA_API_KEY=your-sambanova-key

# ---- Mistral (Distractors / maintenance drafts) ----
MISTRAL_API_KEY=your-mistral-key

# ---- Supabase (Auth + Core Postgres) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ-your-anon-key
SUPABASE_SECRET_KEY=eyJ-your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_URL=postgresql://...@db.your-project.supabase.co:5432/postgres

# ---- Turso (High-volume attempt data) ----
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# ---- Cloudflare ----
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_AI_GATEWAY_ID=your-gateway-id
TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# ---- Email Providers (Stage B) ----
RESEND_API_KEY=re_your-key
RESEND_WEBHOOK_SECRET=your-webhook-secret
BREVO_API_KEY=your-brevo-key
MAILJET_API_KEY=your-mj-key
MAILJET_SECRET_KEY=your-mj-secret

# ---- Razorpay (Stage B) ----
RAZORPAY_KEY_ID=rzp_test_your-id
RAZORPAY_KEY_SECRET=your-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ---- App Secrets (generate with secure generator) ----
APP_ENCRYPTION_KEY=generate-32-random-bytes
BACKUP_ENCRYPTION_KEY=generate-32-random-bytes
SESSION_SIGNING_SECRET=generate-32-random-bytes
CRON_SECRET=generate-32-random-bytes

# ---- Monitoring ----
SENTRY_DSN=https://your-dsn@sentry.io/project
SENTRY_AUTH_TOKEN=your-auth-token
BETTERSTACK_SOURCE_TOKEN=your-token
CLARITY_PROJECT_ID=your-clarity-id

# ---- App Config ----
APP_URL=http://localhost:3000
APP_ENV=development
