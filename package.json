{
  "name": "learning-point",
  "private": true,
  "description": "Learning Point — Exam-focused test & learning platform (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @learning-point/web",
    "build": "npm run build --workspace @learning-point/web",
